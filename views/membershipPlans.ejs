<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <title><%=title %></title>

    <link rel="stylesheet" href="css/style.css" />
  </head>

  <body>
    <div class="menu-container">
      <h1>FlexiFit Gym</h1>
      <h2 class="menu-title">Choose Your Membership Plan</h2>

      <div class="menu-grid">
        <!-- Monthly Plan -->
        <div class="menu-card">
          <h3>Monthly Plan</h3>
          <p>€40 per month</p>

          <ul>
            <li>Full gym access</li>
            <li>Free fitness assessment</li>
            <li>Cancel anytime</li>
          </ul>
          <form action="/select-plan" method="POST">
              <input type="hidden" name="plan" value="Monthly">
              <button type="submit">Apply for Monthly</button>
          </form>

        </div>

        <!-- Annual Plan -->
        <div class="menu-card">
          <h3>Annual Plan</h3>
          <p>€400 per year</p>

          <ul>
            <li>Full gym access</li>
            <li>Free fitness assessment</li>
            <li>2 months free</li>
          </ul>
          <form action="/select-plan" method="POST">
              <input type="hidden" name="plan" value="Annual">
              <button type="submit">Apply for Annual</button> 
          </form>

        </div>
      </div>
    </div>
  </body>
</html>
