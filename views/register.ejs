<!DOCTYPE html>
<html lang="en">
    <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>| <%= title %>
    </title>
    <!-- Link to external CSS file used for styling the page -->
    <link rel="stylesheet" href="css/style.css">

</head>
<body class="no-header">
<div class="register-container">


<h2>Create Account   </h2>

<p>Please register below:   </p>
 <!-- <form action="/register" method="POST" autocomplete="off">  </form>-->
  <form id="memberForm" autocomplete="off">
    <div class = "name-row">
    <input id="firstName" type="text"  name="firstName" placeholder="First Name" required >
    <input id="lastName" type="text" name="lastName" placeholder="Last Name" required>
    
    </div>

   
    
    <input id="email" type="email" name="email" placeholder="Email" required autocomplete="off">
    <input id="dateOfBirth" type="date" name="dateOfBirth" placeholder="Date of Birth" required>
    <input id="address" type="text" name="address" placeholder="Address" required>
    <input id="membershipType" type="hidden" name="membershipType">
    <input id="phoneNumber" type="tel" name="phoneNumber" placeholder="Phone Number" required>

    <input id="password" type="password" name="password" placeholder="Password" required autocomplete="new-password">
    

    <button type="submit">Get Started</button>
  </form>
  <p>Already have an account? </p>
  <a href="/login">Login here</a>
    </div> 
    <script src="js/register_Daniel.js"></script> 
</body>
</html>

